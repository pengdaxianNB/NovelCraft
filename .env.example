# Database
POSTGRES_USER=novel_user
POSTGRES_PASSWORD=novel_pass
POSTGRES_DB=novel_agent
DATABASE_URL=postgresql+asyncpg://novel_user:novel_pass@db:5432/novel_agent

# Redis
REDIS_URL=redis://redis:6379/0
